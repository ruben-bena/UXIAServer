meta {
  name: [PROXMOX] VALID body
  type: http
  seq: 4
}

post {
  url: {{proxmox-uri}}/api/analitzar-imatge
  body: json
  auth: inherit
}

body:json {
  {
    "model": "qwen2.5vl:7b",
    "stream": false,
    "prompt": "Analyze the image and respond ONLY with valid JSON in this exact structure:\n\n{\n  \"description\": \"string\",\n  \"tags\": [\"tag1\", \"tag2\", \"tag3\"]\n}\n\nRules:\n- description: clear description in English.\n- tags: array of relevant keywords in lowercase.\n- Maximum 4 tags.\n- Do not include any text outside the JSON."
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
